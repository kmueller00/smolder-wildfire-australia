# Settings for new SMOLDER runs (from 2026-10), loaded on top of smolder.env.
# smolder.env stays the recipe of the published model (v1.0); every setting
# here is a deliberate change from it. Values set explicitly for a job win.
# The inputs of the retrained model are set per job (USE_FRP=1,
# USE_BARRA_UV=1, USE_FUEL_AGE=1, USE_ELEVATION=1, USE_SLOPE_ASPECT=1).
#
# Leak-free slow window: always on (default of the datamodule since 067be08).
# Repaired 2016 cube (d7192f0).

CAUSAL_INPUTS=1           # only information up to the issue day (leak audit 2026-10-06): NDVI from ended composites, BARRA-C2 tasmax instead of LST, LAI with 31-day lag, biomass Y-1, land cover Y-2, no target window across splits
VPD_SOURCE=barra          # BARRA-C2 4.4 km VPD at tasmax instead of the ERA5-based 31 km product
USE_FAST_NDVI=1           # MODIS 500 m NDVI as a daily fast-branch channel (newest ended composite); LAI stays in the slow branch
MIN_EPOCHS=40             # train the whole cosine schedule (40 epochs); early stopping cut runs at epoch 19 before the learning rate had come down
FUEL_AGE_LOOKBACK=1095    # if USE_FUEL_AGE=1: days since last fire up to three years (cap test 2019: results/nearfield_gate_fuelage_caps_2019.json)
NUM_WORKERS=16            # data-loading workers per run (32 cores reserved); each has its own random stream (seed_worker)
COMPILE=1                 # torch.compile of the forward passes: -40 % time per step, -40 % GPU memory (bf16 rounding only)
FAST_STORES=1             # time-blocked input stores (build_fast_stores): same values, ~50 instead of ~560 chunk reads per sample
COMPACT_STATICS=1         # statics and day of year added on the GPU instead of repeated over time steps in the workers (same values)
COSINE_T_MAX=40           # cosine learning rate decays once over all 40 epochs (with 25 it reached 0 at epoch 25 and rose again)
PATIENCE=7                # early stopping after 7 epochs without a higher val_ap (6 in smolder.env runs)
