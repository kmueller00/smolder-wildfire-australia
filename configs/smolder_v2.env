# Standard for new SMOLDER runs (from 2026-10), loaded on top of smolder.env.
# smolder.env stays the recipe of the released model (v1.0); every setting
# here is a deliberate change from it. Values set explicitly for a job win.
#
# Leak-free slow window: always on (default of the datamodule since 067be08).
# Repaired 2016 cube (d7192f0).

VPD_SOURCE=barra          # BARRA-C2 4.4 km VPD at tasmax instead of the ERA5-based 31 km product
USE_FAST_NDVI=1           # MODIS 500 m NDVI as a daily fast-branch channel; LAI stays in the slow branch
MIN_EPOCHS=20             # no early stopping before epoch 20 (the weight anneal ends at epoch 8)
FUEL_AGE_LOOKBACK=730     # if USE_FUEL_AGE=1: days since last fire up to two years (savanna fuels build up over 1-3 years)
