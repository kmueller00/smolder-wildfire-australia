# Standard for new SMOLDER runs (from 2026-10), loaded on top of smolder.env.
# smolder.env stays the recipe of the released model (v1.0); every setting
# here is a deliberate change from it. Values set explicitly for a job win.
#
# Leak-free slow window: always on (default of the datamodule since 067be08).
# Repaired 2016 cube (d7192f0).

VPD_SOURCE=barra          # BARRA-C2 4.4 km VPD at tasmax instead of the ERA5-based 31 km product
USE_FAST_NDVI=1           # MODIS 500 m NDVI as a daily fast-branch channel; LAI stays in the slow branch
MIN_EPOCHS=20             # no early stopping before epoch 20 (the weight anneal ends at epoch 8)
FUEL_AGE_LOOKBACK=1095    # if USE_FUEL_AGE=1: days since last fire up to three years (cap test 2019: results/nearfield_gate_fuelage_caps_2019.json)
NUM_WORKERS=16            # data-loading workers per run (32 cores reserved); each has its own random stream (seed_worker)
COMPILE=1                 # torch.compile of the forward passes: -40 % time per step, -40 % GPU memory (bf16 rounding only)
FAST_STORES=1             # time-blocked input stores (build_fast_stores): same values, ~50 instead of ~560 chunk reads per sample
COMPACT_STATICS=1         # statics and day of year added on the GPU instead of repeated over time steps in the workers (same values)
