# The final SMOLDER model (causal B, job 1832147, commit ea4e11d): the settings that
# differ from configs/smolder.env and configs/smolder_new_runs.env. Source all three,
# in this order:
#   set -a; source configs/smolder.env; source configs/smolder_new_runs.env; source configs/smolder_final.env; set +a
MAX_EPOCHS=50
MIN_EPOCHS=50             # no early stopping: the whole cosine schedule is trained
COSINE_T_MAX=50
LR=3e-4
SLOW_VEG=lai500           # HiQ-LAI 500 m (31-day delay) in the slow branch
USE_FRP=1                 # VIIRS fire radiative power, 3 channels
USE_BARRA_UV=1            # BARRA-C2 10 m wind components
USE_WIND_ALIGN=1          # wind direction against the direction to the nearest recent fire
USE_FUEL_AGE=1            # days since the pixel last burned, capped at FUEL_AGE_LOOKBACK
USE_ELEVATION=1
USE_SLOPE_ASPECT=1
PERFECT_FORECAST=0
USE_VPD_ANOMALY=0
