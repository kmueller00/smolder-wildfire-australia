# Training configuration of SMOLDER (v1.0, leak-free fire history).
# Architecture, loss and sampling settings are those of the original model and
# were checked against the hyperparameters stored in its checkpoint.
#
# One run: 40 epochs, cosine learning-rate schedule with a 25-epoch period
# (the rate falls to 0 at epoch 25 and rises again afterwards), early stopping
# on validation AP with patience 6. The released weights are the average of the
# three best checkpoints by validation AP
# (smolder/evaluation/average_checkpoints.py).

SEED=123
RUN_TAG=smolder

# data sampling
PATCH_SIZE=384            # min_pos_pixels is derived from this (45 at 384 px)
SAMPLES_PER_EPOCH=2000
BATCH_SIZE=2
ACCUM=4                   # effective batch 8
AUGMENT=0                 # the released model was trained without flips/rotations
NEW_FIRE_FRAC=0.3         # 30% of draws must contain a target fire pixel absent from the newest fire history
MIN_NEW_FIRE_PIXELS=1

# inputs
SLOW_DAYS=144             # LAI, soil moisture, precipitation in 8-day bins
FAST_DAYS=14              # VPD, LST, wind, daily
FIRE_HISTORY=1
FIRE_HISTORY_LAGS=3:4:5          # relative to each timestep's target: history ends the day before it
FIRE_HISTORY_DISTANCE=1
FIRE_HISTORY_DROPOUT_PROB=0.3
USE_LIGHTNING=0
USE_ELEVATION=0
USE_SLOPE_ASPECT=0
USE_FUEL_AGE=0
USE_WIND_DIR=0
USE_STATIC_HEAD=0

# architecture
HIDDEN_LAYERS=1
KERNEL_SIZE=5
DILATION=1
FUSE=cross_attn
ATTN_HEADS=4

# loss
POS_WEIGHT=100.0
POS_WEIGHT_START=100.0    # annealed linearly ...
POS_WEIGHT_END=20.0       # ... to this value ...
POS_WEIGHT_ANNEAL_EPOCHS=8  # ... over this many epochs
ISOLATION_GAMMA=2.0       # up-weights spatially isolated positive pixels
ISOLATION_KERNEL=9
DICE_END_EPOCH=3          # BCE + 0.3*Dice for epochs 0-2, BCE afterwards
FOCAL_START_EPOCH=999     # focal loss never enabled (it destabilised training)
SOFT_POS=0.9
SOFT_NEG=0.02
OHEM_FRAC=0.0
WEIGHT_DECAY=0.01         # AdamW, lr 3e-4, cosine schedule

MAX_EPOCHS=40
COSINE_T_MAX=25
